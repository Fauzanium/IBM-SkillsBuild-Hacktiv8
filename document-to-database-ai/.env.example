
# ── LLM Provider ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini          # or gpt-4o for higher accuracy
OPENAI_TEMPERATURE=0.0            # 0 = deterministic; ideal for extraction

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./document_db.sqlite

# PostgreSQL (production) — uncomment and fill in
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/document_db

# ── System Behaviour ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
MAX_RETRIES=3                     # LLM call retry attempts
EXTRACTION_TIMEOUT=60             # seconds per document
